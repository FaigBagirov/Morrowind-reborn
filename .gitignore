# tes3conv JSON dumps of the masters, ~220 MB, regenerated by
# tools/scripts/wo1_survey.py on demand.
tools/cache/
tools/scripts/__pycache__/

# Build outputs, regenerated by tools/scripts/transform.py.
tools/build/

# Game screenshots pulled back with tools/scripts/play2.ps1, ~2.5 MB each, and
# the pid of the game this worktree started. Both are session state, not source.
logs/shots/
logs/play2.pid

# Our own isolated OpenMW config and user-data, regenerated by
# tools/scripts/play2.ps1 on every launch.
run/

# A redirected launch once wrote the OpenMW log relative to the working
# directory; keep that artifact out if it ever happens again.
/Games/

# Local AI tooling from D:\Work\AI models (game-control, local-workers MCP
# servers). Machine-specific absolute paths, not part of the mod.
/.mcp.json
/.claude/settings.local.json
