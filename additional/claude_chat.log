    fn=getattr(lua,f); fn.argtypes=a; fn.restype=r
lua.lua_tolstring.argtypes=[ctypes.c_void_p,ctypes.c_int,ctypes.c_void_p]
lua.lua_tolstring.restype=ctypes.c_char_p

L = lua.luaL_newstate(); lua.luaL_openlibs(L)
base = sys.argv[2].replace("\\","/")
if lua.luaL_loadstring(L, ("BASE=[[%s]]" % base).encode()) == 0:
    lua.lua_pcall(L,0,0,0)
rc = lua.luaL_loadfile(L, sys.argv[1].encode("utf-8"))
if rc != 0:
    print("LOAD ERROR:", lua.lua_tolstring(L,-1,None)); sys.exit(1)
rc = lua.lua_pcall(L,0,0,0)
if rc != 0:
    msg = lua.lua_tolstring(L,-1,None)
    print("\nRUNTIME ERROR:", msg.decode("utf-8","replace") if msg else "?"); sys.exit(1)
sys.exit(0)
